<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wordly.usage.sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/wordly_apps/Documents/Code/Wordly_Usage_to_HS/wordly_unified_master_v3.2b_LOCAL.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/wordly_apps/Documents/Code/Wordly_Usage_to_HS</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/wordly_apps/Documents/Code/Wordly_Usage_to_HS/logs/wordly_sync.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/wordly_apps/Documents/Code/Wordly_Usage_to_HS/logs/wordly_sync_error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/wordly_apps</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>